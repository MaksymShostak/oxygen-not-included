{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://steam-community-bbcode.invalid/schema/constructs.schema.json",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "registryVersion",
    "constructs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "registryVersion": {
      "$ref": "common.schema.json#/definitions/registryVersion"
    },
    "constructs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "syntaxKind",
          "contentModel",
          "provenance",
          "profiles",
          "gfmMapping",
          "examples"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/definitions/identifier"
          },
          "syntaxKind": {
            "enum": [
              "pairedTag",
              "boundaryTag",
              "opaqueTag",
              "urlEmbed",
              "rendererTransformation"
            ]
          },
          "tagName": {
            "type": "string",
            "pattern": "^(?:[a-z][a-z0-9]*|\\*)$"
          },
          "rendererKind": {
            "$ref": "common.schema.json#/definitions/identifier"
          },
          "contentModel": {
            "enum": [
              "phrasing",
              "flow",
              "listItems",
              "tableRows",
              "tableCells",
              "opaqueText"
            ]
          },
          "provenance": {
            "$ref": "common.schema.json#/definitions/provenance"
          },
          "profiles": {
            "type": "object",
            "propertyNames": {
              "$ref": "common.schema.json#/definitions/identifier"
            },
            "additionalProperties": {
              "$ref": "common.schema.json#/definitions/status"
            }
          },
          "gfmMapping": {
            "$ref": "common.schema.json#/definitions/mapping"
          },
          "examples": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/definitions/nonEmptyText"
            }
          },
          "notes": {
            "$ref": "common.schema.json#/definitions/nonEmptyText"
          },
          "observation": {
            "enum": ["sourceOccurrence", "contextOnly"]
          },
          "contextReason": {
            "$ref": "common.schema.json#/definitions/nonEmptyText"
          }
        },
        "allOf": [
          {
            "if": {"required": ["observation"], "properties": {"observation": {"const": "contextOnly"}}},
            "then": {
              "required": ["contextReason"],
              "properties": {
                "contextReason": true,
                "syntaxKind": {"const": "rendererTransformation"},
                "examples": {"type": "array", "maxItems": 0},
                "gfmMapping": {"type": "object", "properties": {"fidelity": {"const": "unsupported"}}}
              }
            },
            "else": {"properties": {"examples": {"type": "array", "minItems": 1}, "contextReason": false}}
          },
          {
            "if": {
              "properties": {
                "syntaxKind": {
                  "enum": [
                    "pairedTag",
                    "boundaryTag",
                    "opaqueTag"
                  ]
                }
              }
            },
            "then": {
              "properties": {"tagName": true, "rendererKind": false},
              "required": [
                "tagName"
              ]
            },
            "else": {
              "properties": {"rendererKind": true, "tagName": false},
              "required": [
                "rendererKind"
              ]
            }
          }
        ]
      }
    }
  }
}
