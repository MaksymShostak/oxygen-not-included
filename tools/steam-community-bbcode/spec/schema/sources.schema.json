{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://steam-community-bbcode.invalid/schema/sources.schema.json",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "registryVersion",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "registryVersion": {
      "$ref": "common.schema.json#/definitions/registryVersion"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "authority",
          "checkedAt"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/definitions/identifier"
          },
          "title": {
            "$ref": "common.schema.json#/definitions/nonEmptyText"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "authority": {
            "$ref": "common.schema.json#/definitions/nonEmptyText"
          },
          "checkedAt": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
