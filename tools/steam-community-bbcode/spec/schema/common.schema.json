{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://steam-community-bbcode.invalid/schema/common.schema.json",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-only",
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.*-]*$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1
    },
    "registryVersion": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "documented",
        "communityObserved",
        "historical",
        "disputed",
        "unsupported"
      ]
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "status"
        ],
        "properties": {
          "sourceId": {
            "$ref": "#/definitions/identifier"
          },
          "status": {
            "$ref": "#/definitions/status"
          }
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fidelity",
        "strategy"
      ],
      "properties": {
        "fidelity": {
          "enum": [
            "exact",
            "equivalent",
            "approximate",
            "lossy",
            "unsupported"
          ]
        },
        "strategy": {
          "$ref": "#/definitions/identifier"
        }
      }
    }
  }
}

