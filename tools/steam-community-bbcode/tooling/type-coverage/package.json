{
  "name": "steam-community-bbcode-type-coverage",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {"node": ">=22"},
  "scripts": {
    "check": "type-coverage --project ../../tsconfig.json --not-only-in-cwd --at-least 100 --is 100 --strict --detail --report-semantic-error",
    "check:api-docs": "type-coverage --project ../api-docs/tsconfig.json --not-only-in-cwd --at-least 100 --is 100 --strict --detail --report-semantic-error"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "type-coverage": "2.30.1",
    "typescript": "6.0.3"
  }
}
