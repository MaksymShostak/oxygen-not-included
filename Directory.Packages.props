<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <TUnitVersion>1.86.6</TUnitVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="ILRepack.Lib.MSBuild.Task" Version="2.0.48" />
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />
    <PackageVersion Include="Microsoft.DiaSymReader" Version="2.2.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
    <PackageVersion Include="PLib" Version="4.26.0" />
    <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <PackageVersion Include="System.CommandLine" Version="2.0.15" />
    <PackageVersion Include="Tomlyn" Version="2.11.1" />
    <PackageVersion Include="TUnit.Engine" Version="$(TUnitVersion)" />
    <PackageVersion Include="TUnit.Assertions" Version="$(TUnitVersion)" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
