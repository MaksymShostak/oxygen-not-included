msgid "Game log excerpt saved in this local report."
msgstr "A játéknapló részlete ebben a helyi jelentésben van elmentve."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.STATUS_LOG_NOT_INCLUDED
