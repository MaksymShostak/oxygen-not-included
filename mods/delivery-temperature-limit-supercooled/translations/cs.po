msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.STATUS_LOG_INCLUDED"
msgid "Game log excerpt saved in this local report."
msgstr "Výňatek z herního protokolu je uložen v tomto místním hlášení."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.STATUS_LOG_NOT_INCLUDED
