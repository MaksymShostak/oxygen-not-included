#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.TITLE
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.TITLE"
msgid "Delivery Temperature Limit"
msgstr "Limit temperatury dostaw"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.SECTION_RANGE
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.SECTION_RANGE"
msgid "Temperature range"
msgstr "Zakres temperatur"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.LOWER_BOUND
#. TRANSLATORS: Inclusive lower temperature bound: T >= minimum. Keep brief.
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.LOWER_BOUND"
msgid "At least"
msgstr "Co najmniej"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.UPPER_BOUND
#. TRANSLATORS: Exclusive upper temperature bound: T < maximum. Do not translate as "at most".
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.UPPER_BOUND"
msgid "Below"
msgstr "Poniżej"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.BUTTON_CLEAR
#. TRANSLATORS: Clears both fields; this removes both temperature limits, not factory defaults.
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.BUTTON_CLEAR"
msgid "Clear"
msgstr "Wyczyść"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.STATUS.DISABLED
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.STATUS.DISABLED"
msgid "No temperature limit"
msgstr "Bez ograniczeń temperatury"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.STATUS.LOWER_BOUND_ONLY
#, csharp-format
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.STATUS.LOWER_BOUND_ONLY"
msgid "Allows deliveries at or above {0}"
msgstr "Dozwolone dostawy o temperaturze co najmniej {0}"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.STATUS.UPPER_BOUND_ONLY
#, csharp-format
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.STATUS.UPPER_BOUND_ONLY"
msgid "Allows deliveries below {0}"
msgstr "Dozwolone dostawy o temperaturze poniżej {0}"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.STATUS.INTERVAL
#. TRANSLATORS: {0} is the inclusive minimum; {1} is the exclusive maximum. Both include units.
#, csharp-format
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.STATUS.INTERVAL"
msgid "Allows deliveries at or above {0} and below {1}"
msgstr "Dozwolone dostawy o temperaturze co najmniej {0} i poniżej {1}"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.VALIDATION.EMPTY_INTERVAL
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.VALIDATION.EMPTY_INTERVAL"
msgid "<color=#F0B310>▲</color> No deliveries can match this range"
msgstr "<color=#F0B310>▲</color> Żadna dostawa nie może spełnić warunków tego zakresu"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.VALIDATION.BOUNDS_REVERSED
#. TRANSLATORS: Reference the exact translated LOWER_BOUND and UPPER_BOUND labels. Equality is handled by a separate warning.
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.VALIDATION.BOUNDS_REVERSED"
msgid "<color=#F44A47>▲</color> \"At least\" must not be above \"Below\""
msgstr "<color=#F44A47>▲</color> Wartość „Co najmniej” nie może być wyższa niż „Poniżej”"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.VALIDATION.INVALID_NUMBER
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.VALIDATION.INVALID_NUMBER"
msgid "<color=#F44A47>▲</color> Enter a whole-number temperature"
msgstr "<color=#F44A47>▲</color> Podaj temperaturę jako liczbę całkowitą"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.VALIDATION.OUT_OF_RANGE
#, csharp-format
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.VALIDATION.OUT_OF_RANGE"
msgid "<color=#F44A47>▲</color> Temperature must be between {0} and {1}"
msgstr "<color=#F44A47>▲</color> Temperatura musi mieścić się w zakresie od {0} do {1}"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.TOOLTIPS.LOWER_BOUND
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.TOOLTIPS.LOWER_BOUND"
msgid "Minimum temperature for delivered materials. This value is included. Leave blank for no minimum."
msgstr "Minimalna temperatura dostarczanych materiałów. Materiały o dokładnie tej temperaturze są dozwolone. Pozostaw puste, aby nie ustawiać minimum."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.TOOLTIPS.UPPER_BOUND
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.TOOLTIPS.UPPER_BOUND"
msgid "Upper temperature boundary for delivered materials. Materials at exactly this boundary are excluded. Leave blank for no upper limit."
msgstr "Górna granica temperatury dostarczanych materiałów. Materiały o temperaturze równej tej granicy są wykluczone. Pozostaw puste, aby nie ustawiać górnej granicy."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.TOOLTIPS.CLEAR
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.TOOLTIPS.CLEAR"
msgid "Remove both temperature limits."
msgstr "Usuń oba ograniczenia temperatury."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.TOOLTIPS.STATUS
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.SIDESCREEN.TOOLTIPS.STATUS"
msgid "Delivery Temperature Limit checks a material's temperature when choosing resources for delivery."
msgstr "Delivery Temperature Limit sprawdza temperaturę materiału podczas wybierania zasobów do dostawy."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.DIALOG_TITLE
#. TRANSLATORS: Use exactly space-hyphen-space in msgstr. Keep the original msgid unchanged.
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.DIALOG_TITLE"
msgid "Delivery Temperature Limit - Options"
msgstr "Delivery Temperature Limit - Opcje"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.DIALOG_INTRO
#. TRANSLATORS: Building-specific ranges are set in building panels. Settings in this Options dialog are shared across colonies.
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.DIALOG_INTRO"
msgid "Set individual buildings' delivery ranges in their details panels. These settings are shared across your colonies."
msgstr "Zakresy temperatur dostaw dla poszczególnych budynków ustawisz w ich panelach szczegółów. Opcje w tym oknie są wspólne dla wszystkich twoich kolonii."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.RESTART_NOTICE
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.RESTART_NOTICE"
msgid "Changes take effect after restarting Oxygen Not Included."
msgstr "Zmiany zaczną obowiązywać po ponownym uruchomieniu Oxygen Not Included."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.PENDING_RESTART_NOTICE
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.PENDING_RESTART_NOTICE"
msgid "Saved changes are waiting for a restart. This session still uses its startup settings."
msgstr "Zapisane zmiany czekają na ponowne uruchomienie gry. Bieżąca sesja nadal używa ustawień z chwili uruchomienia."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.SECTION_CONSTRUCTION
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.SECTION_CONSTRUCTION"
msgid "Construction"
msgstr "Budowa"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.CHECKBOX_LIMIT_CONSTRUCTION
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.CHECKBOX_LIMIT_CONSTRUCTION"
msgid "Limit construction material temperatures"
msgstr "Ogranicz temperaturę materiałów budowlanych"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.LABEL_DEFAULT_CONSTRUCTION_RANGE
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.LABEL_DEFAULT_CONSTRUCTION_RANGE"
msgid "Default range for new construction"
msgstr "Domyślny zakres dla nowych budów"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.TOOLTIP_DEFAULT_CONSTRUCTION_RANGE
#. SOURCE REPAIR: English text recovered verbatim from TRANSLATION_HANDOFF_GUIDE.md.
#. Verify the corresponding source declaration and extractor before the next regeneration.
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.TOOLTIP_DEFAULT_CONSTRUCTION_RANGE"
msgid "Existing construction sites are not updated. Limits are rounded to whole Kelvin values; the lower bound is included and the upper bound is excluded."
msgstr "Istniejące place budowy nie zostaną zaktualizowane. Limity są zaokrąglane do pełnych kelwinów. Dolna granica jest wliczana do zakresu, a górna jest wykluczona."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.SECTION_RESOURCE_WARNINGS
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.SECTION_RESOURCE_WARNINGS"
msgid "Resource warnings"
msgstr "Ostrzeżenia o zasobach"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.CHECKBOX_WARN_ON_BLOCKED
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.CHECKBOX_WARN_ON_BLOCKED"
msgid "Warn when temperature limits block delivery"
msgstr "Ostrzegaj, gdy limity temperatury blokują dostawę"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.TOOLTIP_WARN_ON_BLOCKED
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.TOOLTIP_WARN_ON_BLOCKED"
msgid "Includes temperature in the Lacks Resources check. Does not change delivery filtering."
msgstr "Uwzględnia temperaturę przy sprawdzaniu stanu „Brak zasobów”. Nie zmienia filtrowania dostaw."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.NOTICE_RESOURCE_WARNINGS_UNAVAILABLE
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.NOTICE_RESOURCE_WARNINGS_UNAVAILABLE"
msgid "Temperature-aware resource warnings are unavailable in this session. Your preference is retained."
msgstr "Ostrzeżenia o zasobach uwzględniające temperaturę są niedostępne w tej sesji. Wybrana opcja zostaje zachowana."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.VALIDATION_INTEGER_REQUIRED
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.VALIDATION_INTEGER_REQUIRED"
msgid "Enter a whole-number temperature in the unit shown."
msgstr "Podaj temperaturę jako liczbę całkowitą w wyświetlanej jednostce."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.VALIDATION_SUPPORTED_RANGE
#. TRANSLATORS: {0} and {1} are the endpoints; {2} is the displayed unit. Preserve all three placeholders.
#, csharp-format
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.VALIDATION_SUPPORTED_RANGE"
msgid "The rounded temperature must be within the supported range: {0} to {1} {2}."
msgstr "Po zaokrągleniu temperatura musi mieścić się w obsługiwanym zakresie: od {0} do {1} {2}."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.VALIDATION_EMPTY_INTERVAL
#. TRANSLATORS: Reference the exact translated bound labels. After rounding to integer kelvin values, minimum must be strictly less than maximum.
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.VALIDATION_EMPTY_INTERVAL"
msgid "The 'At least' value must be lower than 'Below' after rounding to whole Kelvin values. Choose a nonempty construction range."
msgstr "Po zaokrągleniu do pełnych kelwinów wartość „Co najmniej” musi być niższa niż „Poniżej”. Wybierz zakres dla budowy, który obejmuje przynajmniej jedną temperaturę."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_REVERT_RANGE
#. TRANSLATORS: Undo unsaved range edits and restore the last-saved values; do not confuse with Restore defaults.
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_REVERT_RANGE"
msgid "Revert temperature edits"
msgstr "Cofnij zmiany temperatury"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BANNER_LEGACY_UNIT
#. TRANSLATORS: Interpret existing numbers in the chosen unit; this is not a request to convert their numeric values. {0} is a unit symbol.
#, csharp-format
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BANNER_LEGACY_UNIT"
msgid "Unspecified unit in previous settings: pre-interpreted as {0}. Select a unit if different:"
msgstr "Poprzednie ustawienia nie określają jednostki. Wstępnie przyjęto {0}. Wybierz inną jednostkę, jeśli to nie ta:"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_INTERPRET_CELSIUS
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_INTERPRET_CELSIUS"
msgid "Interpret as °C"
msgstr "Interpretuj jako °C"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_INTERPRET_FAHRENHEIT
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_INTERPRET_FAHRENHEIT"
msgid "Interpret as °F"
msgstr "Interpretuj jako °F"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_INTERPRET_KELVIN
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_INTERPRET_KELVIN"
msgid "Interpret as K"
msgstr "Interpretuj jako K"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_OPEN_HOMEPAGE
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_OPEN_HOMEPAGE"
msgid "Open mod page"
msgstr "Otwórz stronę moda"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_OPEN_CONFIG_FOLDER
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_OPEN_CONFIG_FOLDER"
msgid "Open configuration folder"
msgstr "Otwórz folder konfiguracji"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.TOOLTIP_CONFIG_FOLDER
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.TOOLTIP_CONFIG_FOLDER"
msgid "This action does not save your draft. Close and reopen Options after editing the file externally."
msgstr "Ta czynność nie zapisuje roboczych ustawień. Po edycji pliku poza grą zamknij i ponownie otwórz Opcje."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.TOOLTIP_SUPPORT_REPORT
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.TOOLTIP_SUPPORT_REPORT"
msgid "Create a diagnostic file on this computer. You choose whether to share it."
msgstr "Utwórz plik diagnostyczny na tym komputerze. Ty decydujesz, czy go udostępnić."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.CHECKBOX_INCLUDE_PLAYER_LOG
#. TRANSLATORS: Revised Options flow; translate the current English text.
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.CHECKBOX_INCLUDE_PLAYER_LOG"
msgid "Include game log (optional)"
msgstr "Dołącz dziennik gry (opcjonalnie)"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.TOOLTIP_INCLUDE_PLAYER_LOG
#. TRANSLATORS: Revised Options flow; translate the current English text.
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.TOOLTIP_INCLUDE_PLAYER_LOG"
msgid "Adds recent game log entries to the local report. Logs may contain personal information; known paths are removed where possible. Review the file before attaching it on GitHub."
msgstr "Dodaje ostatnie wpisy dziennika gry do lokalnego raportu. Dzienniki mogą zawierać dane osobowe; znane ścieżki są usuwane w miarę możliwości. Sprawdź plik przed dołączeniem go na GitHubie."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_CREATE_REPORT
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_CREATE_REPORT"
msgid "Create local report"
msgstr "Utwórz raport lokalny"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.STATUS_CREATING_REPORT
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.STATUS_CREATING_REPORT"
msgid "Creating a local report…"
msgstr "Tworzenie raportu lokalnego…"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.STATUS_REPORT_CREATED
#. TRANSLATORS: Revised Options flow; translate the current English text.
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.STATUS_REPORT_CREATED"
msgid "Report saved on this computer."
msgstr "Raport zapisano na tym komputerze."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.STATUS_REPORT_FAILED
#. TRANSLATORS: Revised Options flow; translate the current English text.
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.STATUS_REPORT_FAILED"
msgid "Could not create the report. Try again. Details are in the game log."
msgstr "Nie udało się utworzyć raportu. Spróbuj ponownie. Szczegóły znajdują się w dzienniku gry."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_OPEN_LAST_REPORT_FOLDER
#. TRANSLATORS: Revised Options flow; translate the current English text.
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_OPEN_LAST_REPORT_FOLDER"
msgid "Open report folder"
msgstr "Otwórz folder raportu"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_COPY_REPORT_SUMMARY
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_COPY_REPORT_SUMMARY"
msgid "Copy last report summary"
msgstr "Kopiuj podsumowanie ostatniego raportu"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.STATUS_SUMMARY_COPIED
#. TRANSLATORS: Revised Options flow; translate the current English text.
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.STATUS_SUMMARY_COPIED"
msgid "Report summary copied."
msgstr "Skopiowano podsumowanie raportu."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_OPEN_ISSUE_FORM
#. TRANSLATORS: Revised Options flow; translate the current English text.
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_OPEN_ISSUE_FORM"
msgid "Continue to GitHub"
msgstr "Przejdź do GitHuba"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.STATUS_NO_REPORT
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.STATUS_NO_REPORT"
msgid "Create a local report first. Reports from earlier sessions are not automatically selected."
msgstr "Najpierw utwórz raport lokalny. Raporty z wcześniejszych sesji nie są wybierane automatycznie."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.STATUS_ACTION_FAILED
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.STATUS_ACTION_FAILED"
msgid "The action could not be completed. Details are in Player.log."
msgstr "Nie udało się wykonać tej czynności. Szczegóły znajdziesz w Player.log."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_RESTORE_DEFAULTS
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_RESTORE_DEFAULTS"
msgid "Restore defaults"
msgstr "Przywróć domyślne"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.TOOLTIP_RESTORE_DEFAULTS
#. TRANSLATORS: Only the editable draft changes. Cancel leaves the saved configuration file unchanged.
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.TOOLTIP_RESTORE_DEFAULTS"
msgid "Replaces the draft only. Cancel still leaves the saved file unchanged."
msgstr "Zastępuje tylko robocze ustawienia. Wybranie „Anuluj” nadal pozostawi zapisany plik bez zmian."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_CANCEL
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_CANCEL"
msgid "Cancel"
msgstr "Anuluj"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_SAVE
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_SAVE"
msgid "Save settings"
msgstr "Zapisz ustawienia"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.STATUS_CHANGES_SAVED
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.STATUS_CHANGES_SAVED"
msgid "Changes saved. The running session has not been changed."
msgstr "Zmiany zapisane. Bieżąca sesja nie została zmieniona."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_DONE
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_DONE"
msgid "Done"
msgstr "Gotowe"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_RESTART_NOW
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_RESTART_NOW"
msgid "Restart now"
msgstr "Uruchom ponownie teraz"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_RESTART_LATER
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_RESTART_LATER"
msgid "Later"
msgstr "Później"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.WARNING_RUNNING_COLONY
#. TRANSLATORS: Saving mod options does not save colony/gameplay progress. Preserve the warning.
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.WARNING_RUNNING_COLONY"
msgid "Save your colony and return to the main menu before restarting. Saving options does not save colony progress."
msgstr "Zapisz kolonię i wróć do menu głównego przed ponownym uruchomieniem gry. Zapisanie opcji nie zapisuje postępów kolonii."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.DIALOG_DISCARD_TITLE
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.DIALOG_DISCARD_TITLE"
msgid "Discard unsaved changes?"
msgstr "Odrzucić niezapisane zmiany?"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_CONFIRM_DISCARD
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_CONFIRM_DISCARD"
msgid "Discard changes"
msgstr "Odrzuć zmiany"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_CANCEL_DISCARD
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.BUTTON_CANCEL_DISCARD"
msgid "Keep editing"
msgstr "Kontynuuj edycję"

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.ERROR_SAVE_FAILED
#. SOURCE REPAIR: English text recovered verbatim from TRANSLATION_HANDOFF_GUIDE.md.
#. Verify the corresponding source declaration and extractor before the next regeneration.
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.ERROR_SAVE_FAILED"
msgid "Options were not saved. Your draft is still here. Check file access and disk space; after an external edit, close and reopen Options. Details are in Player.log."
msgstr "Nie zapisano opcji. Robocze ustawienia są nadal dostępne. Sprawdź dostęp do pliku i wolne miejsce na dysku. Po edycji pliku poza grą zamknij i ponownie otwórz Opcje. Szczegóły znajdziesz w Player.log."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.ERROR_LOAD_FAILED
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.ERROR_LOAD_FAILED"
msgid "Options could not be read safely. The configuration has not been changed. Check the file, then reopen Options. Details are in Player.log."
msgstr "Nie udało się bezpiecznie odczytać opcji. Konfiguracja nie została zmieniona. Sprawdź plik, a następnie ponownie otwórz Opcje. Szczegóły znajdziesz w Player.log."

#. STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.ERROR_UI_FAILED
msgctxt "STRINGS.DELIVERY_TEMPERATURE_LIMIT.OPTIONS.ERROR_UI_FAILED"
msgid "The options screen could not be opened safely. No settings were changed. See Player.log for details."
msgstr "Nie udało się bezpiecznie otworzyć okna opcji. Żadne ustawienia nie zostały zmienione. Szczegóły znajdziesz w Player.log."

