{
  "name": "oni-markdown-tooling",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.23.3 || ^24.21.0 || >=26.10.0"
  },
  "scripts": {
    "check": "markdown-quality check --root ../.. --execution-profile .markdown-quality-execution.json --diagnostic-level warning",
    "format": "markdown-quality format --root ../..",
    "inspect": "markdown-quality inspect --root ../.. --execution-profile .markdown-quality-execution.json --json",
    "test": "node --test integration.test.mjs",
    "qualify": "markdown-quality-qualify"
  },
  "devDependencies": {
    "@hadden-industries/markdown-quality": "file:archives/hadden-industries-markdown-quality-1.0.3.tgz"
  },
  "optionalDependencies": {
    "@hadden-industries/markdown-quality-win32-x64": "file:archives/hadden-industries-markdown-quality-win32-x64-1.0.3.tgz",
    "@hadden-industries/markdown-quality-linux-x64": "file:archives/hadden-industries-markdown-quality-linux-x64-1.0.3.tgz"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": ">=0.18.2"
    }
  }
}
