{
  "schemaVersion": 2,
  "profiles": {
    "focused": [
      {
        "name": "Working-tree whitespace",
        "argv": [
          "git",
          "diff",
          "--check"
        ]
      },
      {
        "name": "Generated Codex configuration",
        "argv": [
          "node",
          "scripts/runRepositoryPython.js",
          "scripts/set_up_sdlc.py",
          "--check"
        ]
      }
    ],
    "affected": [
      {
        "name": "Working-tree whitespace",
        "argv": [
          "git",
          "diff",
          "--check"
        ]
      },
      {
        "name": "Generated Codex configuration",
        "argv": [
          "node",
          "scripts/runRepositoryPython.js",
          "scripts/set_up_sdlc.py",
          "--check"
        ]
      },
      {
        "name": "Affected ONI repository checks",
        "argv": [
          "node",
          "scripts/runAffectedChecks.js"
        ],
        "timeoutSeconds": 1200
      }
    ],
    "full": [
      {
        "name": "Working-tree whitespace",
        "argv": [
          "git",
          "diff",
          "--check"
        ]
      },
      {
        "name": "Generated Codex configuration",
        "argv": [
          "node",
          "scripts/runRepositoryPython.js",
